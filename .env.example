# Web3Forms access key. The key is tied to the email it was created with:
# every contact-form message is delivered to THAT email (ahmedsaleemdayala@gmail.com).
# Create one at https://web3forms.com by entering that email, then paste the key here.
# (It is a public key by design, so the NEXT_PUBLIC_ prefix is correct.)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-access-key-here

# Public URL of the deployed site (canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://nextgenzcoder.netlify.app

# Optional: Google Search Console verification token (the content="..." value of the meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
